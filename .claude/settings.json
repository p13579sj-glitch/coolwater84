{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-dotnet-and-packages.mjs",
            "statusMessage": "Checking for dotnet/package commands..."
          }
        ]
      }
    ]
  }
}
